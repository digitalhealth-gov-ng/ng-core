  fhir:ConceptMap.description [ fhir:value "Directional ConceptMap from the WHO SMART Guidelines HIV Concepts CodeSystem\nversion 1.0.0 to Nigeria HIV local programme CodeSystems. Only mappings with\na defensible semantic relationship are included. `equivalent` is used where\nthe source and target meanings substantially correspond; `inexact` is used\nwhere one concept is broader, narrower, contextual, or represents an action\nrather than the local programme category. Unlisted WHO concepts are intentionally\nleft unmapped pending programme and terminology review."] ;
  fhir:ConceptMap.jurisdiction [
     fhir:index 0 ;
     fhir:CodeableConcept.coding [
       fhir:index 0 ;
       fhir:Coding.system [ fhir:value "urn:iso:std:iso:3166" ] ;
       fhir:Coding.code [ fhir:value "NG" ] ;
       fhir:Coding.display [ fhir:value "Nigeria" ]
     ]
  ] ;
  fhir:ConceptMap.purpose [ fhir:value "Supports country adaptation, terminology translation, interoperability, and\ntraceability between WHO SMART HIV DAK concepts and Nigeria HIV programme\nterminology. This map is directional (WHO to Nigeria) and SHALL NOT be assumed\nto provide lossless reverse translation. Clinical or reporting use of mappings\nmarked `inexact` requires review of the source context."] ;
  fhir:ConceptMap.sourceUri [ fhir:value "http://smart.who.int/hiv/CodeSystem/HIVConcepts"] ;
  fhir:ConceptMap.group [
     fhir:index 0 ;
     fhir:ConceptMap.group.source [ fhir:value "http://smart.who.int/hiv/CodeSystem/HIVConcepts" ] ;
     fhir:ConceptMap.group.sourceVersion [ fhir:value "1.0.0" ] ;
     fhir:ConceptMap.group.target [ fhir:value "https://fhir-ig.digitalhealth.gov.ng/CodeSystem/ng-hiv-art-follow-up-status-cs" ] ;
     fhir:ConceptMap.group.element [
       fhir:index 0 ;
       fhir:ConceptMap.group.element.code [ fhir:value "HIV.H.DE42" ] ;
       fhir:ConceptMap.group.element.display [ fhir:value "Lost to follow-up" ] ;
       fhir:ConceptMap.group.element.target [
         fhir:index 0 ;
         fhir:ConceptMap.group.element.target.code [ fhir:value "lost" ] ;
         fhir:ConceptMap.group.element.target.display [ fhir:value "Lost to follow-up" ] ;
         fhir:ConceptMap.group.element.target.equivalence [ fhir:value "equivalent" ] ;
         fhir:ConceptMap.group.element.target.comment [ fhir:value "WHO and Nigeria concepts represent loss to follow-up in HIV treatment follow-up." ]
       ]
     ], [
       fhir:index 1 ;
       fhir:ConceptMap.group.element.code [ fhir:value "HIV.H.DE43" ] ;
       fhir:ConceptMap.group.element.display [ fhir:value "Transferred out" ] ;
       fhir:ConceptMap.group.element.target [
         fhir:index 0 ;
         fhir:ConceptMap.group.element.target.code [ fhir:value "to" ] ;
         fhir:ConceptMap.group.element.target.display [ fhir:value "Transferred out" ] ;
         fhir:ConceptMap.group.element.target.equivalence [ fhir:value "equivalent" ] ;
         fhir:ConceptMap.group.element.target.comment [ fhir:value "Nigeria 'to' is the established local code for transferred out." ]
       ]
     ], [
       fhir:index 2 ;
       fhir:ConceptMap.group.element.code [ fhir:value "HIV.H.DE44" ] ;
       fhir:ConceptMap.group.element.display [ fhir:value "Death (documented)" ] ;
       fhir:ConceptMap.group.element.target [
         fhir:index 0 ;
         fhir:ConceptMap.group.element.target.code [ fhir:value "dead" ] ;
         fhir:ConceptMap.group.element.target.display [ fhir:value "Dead" ] ;
         fhir:ConceptMap.group.element.target.equivalence [ fhir:value "inexact" ] ;
         fhir:ConceptMap.group.element.target.comment [ fhir:value "WHO explicitly requires documented death; the Nigeria local concept is broader." ]
       ]
     ], [
       fhir:index 3 ;
       fhir:ConceptMap.group.element.code [ fhir:value "HIV.D.DE45" ] ;
       fhir:ConceptMap.group.element.display [ fhir:value "Restarting ART" ] ;
       fhir:ConceptMap.group.element.target [
         fhir:index 0 ;
         fhir:ConceptMap.group.element.target.code [ fhir:value "restart" ] ;
         fhir:ConceptMap.group.element.target.display [ fhir:value "Restart ART" ] ;
         fhir:ConceptMap.group.element.target.equivalence [ fhir:value "equivalent" ] ;
         fhir:ConceptMap.group.element.target.comment [ fhir:value "Both represent restarting ART after an interruption." ]
       ]
     ], [
       fhir:index 4 ;
       fhir:ConceptMap.group.element.code [ fhir:value "HIV.D.DE40" ] ;
       fhir:ConceptMap.group.element.display [ fhir:value "Stopped ART" ] ;
