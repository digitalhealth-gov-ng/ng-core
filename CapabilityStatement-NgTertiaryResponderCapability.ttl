  fhir:CapabilityStatement.description [ fhir:value "Minimum computable FHIR requirements for the Nigeria Core Responder role in tertiary referral facilities."] ;
  fhir:CapabilityStatement.useContext [
     fhir:index 0 ;
     fhir:UsageContext.code [
