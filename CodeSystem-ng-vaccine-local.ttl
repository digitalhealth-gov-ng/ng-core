     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: CodeSystem ng-vaccine-local</b></p><a name=\"ng-vaccine-local\"> </a><a name=\"hcng-vaccine-local\"> </a><p>This case-sensitive code system <code>https://fhir-ig.digitalhealth.gov.ng/CodeSystem/ng-vaccine-local</code> defines the following codes:</p><table class=\"codes\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td></tr><tr><td style=\"white-space:nowrap\">IMMZ.Z.DE1<a name=\"ng-vaccine-local-IMMZ.46Z.46DE1\"> </a></td><td>BCG birth dose</td></tr><tr><td style=\"white-space:nowrap\">IMMZ.Z.DE2<a name=\"ng-vaccine-local-IMMZ.46Z.46DE2\"> </a></td><td>HepB birth dose</td></tr><tr><td style=\"white-space:nowrap\">IMMZ.Z.DE3<a name=\"ng-vaccine-local-IMMZ.46Z.46DE3\"> </a></td><td>Polio (OPV0) birth dose</td></tr><tr><td style=\"white-space:nowrap\">IMMZ.Z.DE4<a name=\"ng-vaccine-local-IMMZ.46Z.46DE4\"> </a></td><td>Pentavalent 1</td></tr><tr><td style=\"white-space:nowrap\">IMMZ.Z.DE5<a name=\"ng-vaccine-local-IMMZ.46Z.46DE5\"> </a></td><td>Oral Polio Vaccine (OPV 1)</td></tr><tr><td style=\"white-space:nowrap\">IMMZ.Z.DE6<a name=\"ng-vaccine-local-IMMZ.46Z.46DE6\"> </a></td><td>Pneumococcal Conjugate Vaccine (PCV 1)</td></tr><tr><td style=\"white-space:nowrap\">IMMZ.Z.DE7<a name=\"ng-vaccine-local-IMMZ.46Z.46DE7\"> </a></td><td>Rotavirus 1</td></tr><tr><td style=\"white-space:nowrap\">IMMZ.Z.DE8<a name=\"ng-vaccine-local-IMMZ.46Z.46DE8\"> </a></td><td>Inactivated Polio Vaccine (IPV 1)</td></tr><tr><td style=\"white-space:nowrap\">IMMZ.Z.DE9<a name=\"ng-vaccine-local-IMMZ.46Z.46DE9\"> </a></td><td>Oral Polio Vaccine (OPV 2)</td></tr><tr><td style=\"white-space:nowrap\">IMMZ.Z.DE10<a name=\"ng-vaccine-local-IMMZ.46Z.46DE10\"> </a></td><td>Pneumococcal Conjugate Vaccine (PCV 2)</td></tr><tr><td style=\"white-space:nowrap\">IMMZ.Z.DE11<a name=\"ng-vaccine-local-IMMZ.46Z.46DE11\"> </a></td><td>Pentavalent 2</td></tr><tr><td