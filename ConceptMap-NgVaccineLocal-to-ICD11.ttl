  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: ConceptMap NgVaccineLocal-to-ICD11</b></p><a name=\"NgVaccineLocal-to-ICD11\"> </a><a name=\"hcNgVaccineLocal-to-ICD11\"> </a><p>Mapping from <a href=\"ValueSet-ng-vaccine-local-vs.html\">NG Vaccine Local ValueSet</a> to <a href=\"ValueSet-ng-vaccine-icd-vs.html\">NG Vaccine ICD ValueSet</a></p><br/><p>Mapping from <a href=\"CodeSystem-ng-vaccine-local.html\">NG IMMZ.D.DE4 Vaccine Local Codes (Dose-labelled)</a> to <a href=\"CodeSystem-ng-vaccine-icd-cs.html\">NG IMMZ.D.DE4 ICD11 Vaccine Library</a></p><table class=\"grid\"><tr><td><b>Source Code</b></td><td><b>Relationship</b></td><td><b>Target Code</b></td></tr><tr><td>IMMZ.Z.DE1 (BCG birth dose)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM8142 (BCG vaccine)</td></tr><tr><td>IMMZ.Z.DE2 (HepB birth dose)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM9V38 (Hepatitis B vaccine)</td></tr><tr><td>IMMZ.Z.DE3 (Polio (OPV0) birth dose)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM0N50 (Poliomyelitis vaccines)</td></tr><tr><td>IMMZ.Z.DE5 (Oral Polio Vaccine (OPV 1))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM0N50 (Poliomyelitis vaccines)</td></tr><tr><td>IMMZ.Z.DE9 (Oral Polio Vaccine (OPV 2))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM0N50 (Poliomyelitis vaccines)</td></tr><tr><td>IMMZ.Z.DE13 (Oral Polio Vaccine (OPV 3))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM0N50 (Poliomyelitis vaccines)</td></tr><tr><td>IMMZ.Z.DE8 (Inactivated Polio Vaccine (IPV 1))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM0N50 (Poliomyelitis vaccines)</td></tr><tr><td>IMMZ.Z.DE17 (Inactivated Polio Vaccine (IPV 2))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM0N50 (Poliomyelitis vaccines)</td></tr><tr><td>IMMZ.Z.DE4 (Pentavalent 1)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM1PB8 (DTP-HepB-Hib pentavalent vaccines)</td></tr><tr><td>IMMZ.Z.DE11 (Pentavalent 2)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM1PB8 (DTP-HepB-Hib pentavalent vaccines)</td></tr><tr><td>IMMZ.Z.DE14 (Pentavalent 3)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM1PB8 (DTP-HepB-Hib pentavalent vaccines)</td></tr><tr><td>IMMZ.Z.DE6 (Pneumococcal Conjugate Vaccine (PCV 1))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM9G97 (Pneumococcal conjugate vaccines)</td></tr><tr><td>IMMZ.Z.DE10 (Pneumococcal Conjugate Vaccine (PCV 2))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM9G97 (Pneumococcal conjugate vaccines)</td></tr><tr><td>IMMZ.Z.DE15 (Pneumococcal Conjugate Vaccine (PCV 3))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM9G97 (Pneumococcal conjugate vaccines)</td></tr><tr><td>IMMZ.Z.DE7 (Rotavirus 1)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM1CE0 (Rotavirus vaccines)</td></tr><tr><td>IMMZ.Z.DE12 (Rotavirus 2)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM1CE0 (Rotavirus vaccines)</td></tr><tr><td>IMMZ.Z.DE16 (Rotavirus 3)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM1CE0 (Rotavirus vaccines)</td></tr><tr><td>IMMZ.Z.DE22 (Measles Rubella (MR 1))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM8TF3 (Measles-rubella vaccine)</td></tr><tr><td>IMMZ.Z.DE26 (Measles Rubella (MR 2))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM8TF3 (Measles-rubella vaccine)</td></tr><tr><td>IMMZ.Z.DE23 (Yellow Fever)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM0N24 (Yellow fever vaccine)</td></tr><tr><td>IMMZ.Z.DE24 (Meningitis)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title