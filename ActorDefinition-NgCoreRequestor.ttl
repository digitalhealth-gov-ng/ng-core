     fhir:Extension.valueMarkdown [ fhir:value "A **client application or service** that initiates FHIR requests or exchanges\nusing the Nigeria Core specifications." ]
  ], [
     fhir:index 11 ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-ActorDefinition.jurisdiction" ] ;
     fhir:Extension.valueCodeableConcept [
