# - resource -------------------------------------------------------------------

<https://fhir-ig.digitalhealth.gov.ng/ValueSet/ng-hiv-eac-barriers-vs> a fhir:ValueSet ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "ng-hiv-eac-barriers-vs"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "extensions" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: ValueSet ng-hiv-eac-barriers-vs</b></p><a name=\"ng-hiv-eac-barriers-vs\"> </a><a name=\"hcng-hiv-eac-barriers-vs\"> </a><ul><li>Include these codes as defined in <a href=\"CodeSystem-ng-hiv-eac-form-cs.html\"><code>https://fhir-ig.digitalhealth.gov.ng/CodeSystem/ng-hiv-eac-form-cs</code></a><span title=\"Version is not explicitly stated, which means it is fixed to the version provided in this specification\"> version ?0.0.0</span><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td><a href=\"CodeSystem-ng-hiv-eac-form-cs.html#ng-hiv-eac-form-cs-barrier-forgot\">barrier-forgot</a></td><td style=\"color: #cccccc\">Forgot</td><td>The client forgot to take one or more prescribed ART doses.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-eac-form-cs.html#ng-hiv-eac-form-cs-barrier-knowledge-beliefs\">barrier-knowledge-beliefs</a></td><td style=\"color: #cccccc\">Knowledge or beliefs</td><td>Knowledge, understanding or beliefs affect the client's adherence.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-eac-form-cs.html#ng-hiv-eac-form-cs-barrier-side-effects\">barrier-side-effects</a></td><td style=\"color: #cccccc\">Side effects</td><td>Actual or anticipated medication side effects affect adherence.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-eac-form-cs.html#ng-hiv-eac-form-cs-barrier-physical-illness\">barrier-physical-illness</a></td><td style=\"color: #cccccc\">Physical illness</td><td>Physical illness affects the client's ability or willingness to take ART.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-eac-form-cs.html#ng-hiv-eac-form-cs-barrier-substance-use\">barrier-substance-use</a></td><td style=\"color: #cccccc\">Substance use</td><td>Alcohol or other substance use affects adherence.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-eac-form-cs.html#ng-hiv-eac-form-cs-barrier-depression\">barrier-depression</a></td><td style=\"color: #cccccc\">Depression</td><td>Depression or depressive symptoms affect adherence.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-eac-form-cs.html#ng-hiv-eac-form-cs-barrier-pill-burden\">barrier-pill-burden</a></td><td style=\"color: #cccccc\">Pill burden</td><td>The number, size or frequency of medicines affects adherence.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-eac-form-cs.html#ng-hiv-eac-form-cs-barrier-lost-ran-out-of-drugs\">barrier-lost-ran-out-of-drugs</a></td><td style=\"color: #cccccc\">Lost or ran out of drugs</td><td>The client lost the medicines or exhausted the supply before the next refill.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-eac-form-cs.html#ng-hiv-eac-form-cs-barrier-transport\">barrier-transport</a></td><td style=\"color: #cccccc\">Transport</td><td>Transport availability or cost affects access to ART services or medicines.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-eac-form-cs.html#ng-hiv-eac-form-cs-barrier-child-refusing\">barrier-child-refusing</a></td><td style=\"color: #cccccc\">Child refusing</td><td>A child refuses to take the prescribed ART medicines.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-eac-form-cs.html#ng-hiv-eac-form-cs-barrier-scheduling\">barrier-scheduling</a></td><td style=\"color: #cccccc\">Scheduling</td><td>The client's daily schedule or medication schedule affects adherence.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-eac-form-cs.html#ng-hiv-eac-form-cs-barrier-fear-of-disclosure\">barrier-fear-of-disclosure</a></td><td style=\"color: #cccccc\">Fear of disclosure</td><td>Fear that the client's HIV status may be disclosed affects adherence.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-eac-form-cs.html#ng-hiv-eac-form-cs-barrier-family-partner\">barrier-family-partner</a></td><td style=\"color: #cccccc\">Family or partner</td><td>A family or partner-related issue affects adherence.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-eac-form-cs.html#ng-hiv-eac-form-cs-barrier-food-insecurity\">barrier-food-insecurity</a></td><td style=\"color: #cccccc\">Food insecurity</td><td>Lack of reliable access to adequate food affects adherence.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-eac-form-cs.html#ng-hiv-eac-form-cs-barrier-drug-stock-out\">barrier-drug-stock-out</a></td><td style=\"color: #cccccc\">Drug stock-out</td><td>The medicine was unavailable because of a facility or supply-chain stock-out.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-eac-form-cs.html#ng-hiv-eac-form-cs-barrier-long-waiting-time\">barrier-long-waiting-time</a></td><td style=\"color: #cccccc\">Long waiting time</td><td>Long waiting time at the service-delivery point affects adherence.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-eac-form-cs.html#ng-hiv-eac-form-cs-barrier-stigma\">barrier-stigma</a></td><td style=\"color: #cccccc\">Stigma</td><td>Experienced or anticipated HIV-related stigma affects adherence.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-eac-form-cs.html#ng-hiv-eac-form-cs-barrier-other\">barrier-other</a></td><td style=\"color: #cccccc\">Other barrier</td><td>An adherence barrier not represented by another code; specify separately.</td></tr></table></li></ul></div>"
  ] ;
