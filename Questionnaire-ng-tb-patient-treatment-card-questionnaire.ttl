:0px 4px 0px 4px\" class=\"hierarchy\"/></tr>#xD;\n<tr style=\"border: 1px #F0F0F0 solid; padding:0px; vertical-align: top; background-color: white\"><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: white; border: 1px #F0F0F0 solid; padding:0px 4px 0px 4px; white-space: nowrap; background-image: url(tbl_bck010.png)\" id=\"item.treatment-outcome-value\" class=\"hierarchy\"><img src=\"tbl_spacer.png\" alt=\".\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_blank.png\" alt=\".\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\".\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon-q-coding.png\" alt=\".\" style=\"background-color: white; background-color: inherit\" title=\"coding\" class=\"hierarchy\"/> treatment-outcome-value</td><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: white; border: 1px #F0F0F0 solid; padding:0px 4px 0px 4px\" class=\"hierarchy\">Treatment outcome</td><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: white; border: 1px #F0F0F0 solid; padding:0px 4px 0px 4px\" class=\"hierarchy\">0..1</td><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: white; border: 1px #F0F0F0 solid; padding:0px 4px 0px 4px\" class=\"hierarchy\"><a href=\"https://hl7.org/fhir/R4/codesystem-item-type.html#item-type-choice\">choice</a></td><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: white; border: 1px #F0F0F0 solid; padding:0px 4px 0px 4px\" class=\"hierarchy\">Options: <a href=\"#opt-item.treatment-outcome-value\">7 options</a></td></tr>#xD;\n<tr style=\"border: 1px #F0F0F0 solid; padding:0px; vertical-align: top; background-color: #F7F7F7\"><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: #F7F7F7; border: 1px #F0F0F0 solid; padding:0px 4px 0px 4px; white-space: nowrap; background-image: url(tbl_bck010.png)\" id=\"item.treatment-completion-date\" class=\"hierarchy\"><img src=\"tbl_spacer.png\" alt=\".\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_blank.png\" alt=\".\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\".\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon-q-date.png\" alt=\".\" style=\"background-color: #F7F7F7; background-color: inherit\" title=\"date\" class=\"hierarchy\"/> treatment-completion-date</td><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: #F7F7F7; border: 1px #F0F0F0 solid; padding:0px 4px 0px 4px\" class=\"hierarchy\">Date treatment completed</td><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: #F7F7F7; border: 1px #F0F0F0 solid; padding:0px 4px 0px 4px\" class=\"hierarchy\">0..1</td><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: #F7F7F7; border: 1px #F0F0F0 solid; padding:0px 4px 0px 4px\" class=\"hierarchy\"><a href=\"https://hl7.org/fhir/R4/codesystem-item-type.html#item-type-date\">date</a></td><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: #F7F7F7; border: 1px #F0F0F0 solid; padding:0px 4px 0px 4px\" class=\"hierarchy\"/></tr>#xD;\n<tr style=\"border: 1px #F0F0F0 solid; padding:0px; vertical-align: top; background-color: white\"><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: white; border: 1px #F0F0F0 solid; padding:0px 4px 0px 4px; white-space: nowrap; background-image: url(tbl_bck010.png)\" id=\"item.health-worker-signature\" class=\"hierarchy\"><img src=\"tbl_spacer.png\" alt=\".\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_blank.png\" alt=\".\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin.png\" alt=\".\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon-q-string.png\" alt=\".\" style=\"background-color: white; background-color: inherit\" title=\"string\" class=\"hierarchy\"/> health-worker-signature</td><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: white; border: 1px #F0F0F0 solid; padding:0px 4px 0px 4px\" class=\"hierarchy\">Health worker's signature or signature reference</td><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: white; border: 1px #F0F0F0 solid; padding:0px 4px 0px 4px\" class=\"hierarchy\">0..1</td><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: white; border: 1px #F0F0F0 solid; padding:0px 4px 0px 4px\" class=\"hierarchy\"><a href=\"https://hl7.org/fhir/R4/codesystem-item-type.html#item-type-string\">string</a></td><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: white; border: 1px #F0F0F0 solid; padding:0px 4px 0px 4px\" class=\"hierarchy\"/></tr>#xD;\n<tr style=\"border: 1px #F0F0F0 solid; padding:0px; vertical-align: top; background-color: #F7F7F7\"><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: #F7F7F7; border: 1px #F0F0F0 solid; padding:0px 4px 0px 4px; white-space: nowrap; background-image: url(tbl_bck000.png)\" id=\"item.remarks\" class=\"hierarchy\"><img src=\"tbl_spacer.png\" alt=\".\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_blank.png\" alt=\".\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"tbl_vjoin_end.png\" alt=\".\" style=\"background-color: inherit\" class=\"hierarchy\"/><img src=\"icon-q-text.png\" alt=\".\" style=\"background-color: #F7F7F7; background-color: inherit\" title=\"text\" class=\"hierarchy\"/> remarks</td><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: #F7F7F7; border: 1px #F0F0F0 solid; padding:0px 4px 0px 4px\" class=\"hierarchy\">Remarks</td><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: #F7F7F7; border: 1px #F0F0F0 solid; padding:0px 4px 0px 4px\" class=\"hierarchy\">0..1</td><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: #F7F7F7; border: 1px #F0F0F0 solid; padding:0px 4px 0px 4px\" class=\"hierarchy\"><a href=\"https://hl7.org/fhir/R4/codesystem-item-type.html#item-type-text\">text</a></td><td style=\"vertical-align: top; text-align : var(--ig-left,left); background-color: #F7F7F7; border: 1px #F0F0F0 solid; padding:0px 4px 0px 4px\" class=\"hierarchy\"/></tr>#xD;\n<tr><td colspan=\"5\" class=\"hierarchy\"><br/><a href=\"https://hl7.org/fhir/R4/formats.html#table\" title=\"Legend for this format\"><img src=\"data:image/png;base64,\" alt=\"doco\" style=\"background-color: inherit\"/> Documentation for this format</a></td></tr></table><hr/><p><b>Options Sets</b></p><a name=\"opt-item.sex\"> </a><p><b>Answer options for sex </b></p><ul><li style=\"font-size: 11px\">http://hl7.org/fhir/administrative-gender#male (\"Male\")</li><li style=\"font-size: 11px\">http://hl7.org/fhir/administrative-gender#female (\"Female\")</li></ul><a name=\"opt-item.marital-status\"> </a><p><b>Answer options for marital-status </b></p><ul><li style=\"font-size: 11px\">Married</li><li style=\"font-size: 11px\">Single</li><li style=\"font-size: 11px\">Divorced</li><li style=\"font-size: 11px\">Widow/Widower</li></ul><a name=\"opt-item.site-of-disease\"> </a><p><b>Answer options for site-of-disease </b></p><ul><li style=\"font-size: 11px\">Pulmonary (P)</li><li style=\"font-size: 11px\">Extrapulmonary (EP)</li></ul><a name=\"opt-item.type-of-patient\"> </a><p><b>Answer options for type-of-patient </b></p><ul><li style=\"font-size: 11px\">New (N)</li><li style=\"font-size: 11px\">Relapse (R)</li><li style=\"font-size: 11px\">Treatment after failure (TAF)</li><li style=\"font-size: 11px\">Treatment after loss to follow-up (TALF)</li><li style=\"font-size: 11px\">Other previously treated (OPT)</li><li style=\"font-size: 11px\">Patients with unknown previous TB treatment history (PUPH)</li><li style=\"font-size: 11px\">Transferred in (TI)</li></ul><a name=\"opt-item.source-of-referral\"> </a><p><b>Answer options for source-of-referral </b></p><ul><li style=\"font-size: 11px\">ART facility</li><li style=\"font-size: 11px\">TB patient</li><li style=\"font-size: 11px\">Out Patient Department (OPD)</li><li style=\"font-size: 11px\">Community Volunteer (CV)</li><li style=\"font-size: 11px\">Treatment Supporter (TS)</li><li style=\"font-size: 11px\">Community TB Worker (CTW)</li><li style=\"font-size: 11px\">DOTS facility</li><li style=\"font-size: 11px\">Patent Medicine Vendor (PMV)</li><li style=\"font-size: 11px\">Community Pharmacy (CP)</li><li style=\"font-size: 11px\">Faith-based organization (FBO)</li><li style=\"font-size: 11px\">Private-for-profit (PFP)</li><li style=\"font-size: 11px\">Traditional birth attendant (TBA)</li><li style=\"font-size: 11px\">Stand-alone laboratory</li><li style=\"font-size: 11px\">Community Informant (CI)</li><li style=\"font-size: 11px\">Other</li></ul><a name=\"opt-item.xpert-mtb-result\"> </a><p><b>Answer options for xpert-mtb-result </b></p><ul><li style=\"font-size: 11px\">MTB detected</li><li style=\"font-size: 11px\">MTB not detected</li></ul><a name=\"opt-item.xray-interpretation\"> </a><p><b>Answer options for xray-interpretation </b></p><ul><li style=\"font-size: 11px\">Suggestive</li><li style=\"font-size: 11px\">Not suggestive</li></ul><a name=\"opt-item.tissue-biopsy-interpretation\"> </a><p><b>Answer options for tissue-biopsy-interpretation </b></p><ul><li style=\"font-size: 11px\">Suggestive</li><li style=\"font-size: 11px\">Not suggestive</li></ul><a name=\"opt-item.other-diagnostic-test-result\"> </a><p><b>Answer options for other-diagnostic-test-result </b></p><ul><li style=\"font-size: 11px\">Positive</li><li style=\"font-size: 11px\">Negative</li></ul><a name=\"opt-item.previously-known-hiv-status\"> </a><p><b>Answer options for previously-known-hiv-status </b></p><ul><li style=\"font-size: 11px\">Positive</li><li style=\"font-size: 11px\">Negative</li><li style=\"font-size: 11px\">Unknown</li></ul><a name=\"opt-item.newly-tested-hiv-status\"> </a><p><b>Answer options for newly-tested-hiv-status </b></p><ul><li style=\"font-size: 11px\">Positive</li><li style=\"font-size: 11px\">Negative</li><li style=\"font-size: 11px\">Unknown</li></ul><a name=\"opt-item.end-treatment-hiv-status\"> </a><p><b>Answer options for end-treatment-hiv-status </b></p><ul><li style=\"font-size: 11px\">Positive</li><li style=\"font-size: 11px\">Negative</li><li style=\"font-size: 11px\">Unknown</li></ul><a name=\"opt-item.monitoring-month\"> </a><p><b>Answer options for monitoring-month </b></p><ul><li style=\"font-size: 11px\">0</li><li style=\"font-size: 11px\">2</li><li style=\"font-size: 11px\">3</li><li style=\"font-size: 11px\">5</li><li style=\"font-size: 11px\">6</li></ul><a name=\"opt-item.treatment-regimen\"> </a><p><b>Answer options for treatment-regimen </b></p><ul><li style=\"font-size: 11px\">6 Months Regimen (Regimen 1)</li><li style=\"font-size: 11px\">12 Months Regimen (Regimen 2)</li></ul><a name=\"opt-item.intensive-dose-status\"> </a><p><b>Answer options for intensive-dose-status </b></p><ul><li style=\"font-size: 11px\">X - Medication swallowed under direct observation of facility staff</li><li style=\"font-size: 11px\">A - Medication taken but not observed by facility staff</li><li style=\"font-size: 11px\">O - Medication not taken / missed dose</li><li style=\"font-size: 11px\">Supplied to treatment supporter</li></ul><a name=\"opt-item.continuation-dose-status\"> </a><p><b>Answer options for continuation-dose-status </b></p><ul><li style=\"font-size: 11px\">X - Medication swallowed under direct observation of facility staff</li><li style=\"font-size: 11px\">A - Medication taken but not observed by facility staff</li><li style=\"font-size: 11px\">O - Medication not taken / missed dose</li><li style=\"font-size: 11px\">Supplied to treatment supporter</li></ul><a name=\"opt-item.dot-provider-type\"> </a><p><b>Answer options for dot-provider-type </b></p><ul><li style=\"font-size: 11px\">Treatment Supporter (TS)</li><li style=\"font-size: 11px\">Health Worker</li></ul><a name=\"opt-item.treatment-outcome-value\"> </a><p><b>Answer options for treatment-outcome-value </b></p><ul><li style=\"font-size: 11px\">Cured</li><li style=\"font-size: 11px\">Treatment completed</li><li style=\"font-size: 11px\">Lost to follow-up</li><li style=\"font-size: 11px\">Treatment failed</li><li style=\"font-size: 11px\">Not evaluated</li><li style=\"font-size: 11px\">Died</li><li style=\"font-size: 11px\">Removed from the register</li></ul></div>"
  ] ;
