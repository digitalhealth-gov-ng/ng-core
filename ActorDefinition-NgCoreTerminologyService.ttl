     fhir:index 10 ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-ActorDefinition.description" ] ;
     fhir:Extension.valueMarkdown [ fhir:value "A **terminology service** providing computational access to Nigeria Core\nCodeSystems, ValueSets, ConceptMaps, and supported external terminologies." ]
  ], [
     fhir:index 11 ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-ActorDefinition.jurisdiction" ] ;
     fhir:Extension.valueCodeableConcept [
       fhir:CodeableConcept.coding [
