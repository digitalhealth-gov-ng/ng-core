     fhir:CodeSystem.concept.display [ fhir:value "Immunocompromised" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "The individual has a weakened immune system due to a medical condition (e.g., cancer, organ transplant, or immunosuppressive therapy), which contraindicates certain live vaccines." ]
  ], [
