<https://fhir-ig.digitalhealth.gov.ng/ValueSet/ng-hiv-paediatric-art-medication-vs> a fhir:ValueSet ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "ng-hiv-paediatric-art-medication-vs"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "extensions" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: ValueSet ng-hiv-paediatric-art-medication-vs</b></p><a name=\"ng-hiv-paediatric-art-medication-vs\"> </a><a name=\"hcng-hiv-paediatric-art-medication-vs\"> </a><ul><li>Include these codes as defined in <a href=\"CodeSystem-ng-hiv-pharmacy-order-cs.html\"><code>https://fhir-ig.digitalhealth.gov.ng/CodeSystem/ng-hiv-pharmacy-order-cs</code></a><span title=\"Version is not explicitly stated, which means it is fixed to the version provided in this specification\"> version ?0.0.0</span><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td><a href=\"CodeSystem-ng-hiv-pharmacy-order-cs.html#ng-hiv-pharmacy-order-cs-paediatric-abc-3tc-120-60\">paediatric-abc-3tc-120-60</a></td><td style=\"color: #cccccc\">Abacavir/Lamivudine 120/60 mg</td><td>Paediatric ART formulation. The source form permits once- or twice-daily frequency.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-pharmacy-order-cs.html#ng-hiv-pharmacy-order-cs-paediatric-azt-3tc-60-30\">paediatric-azt-3tc-60-30</a></td><td style=\"color: #cccccc\">Zidovudine/Lamivudine 60/30 mg</td><td>Paediatric ART formulation. The source form preprints twice-daily frequency.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-pharmacy-order-cs.html#ng-hiv-pharmacy-order-cs-paediatric-nvp-50-per-5ml\">paediatric-nvp-50-per-5ml</a></td><td style=\"color: #cccccc\">Nevirapine 50 mg/5 mL</td><td>Paediatric ART formulation. The source form preprints twice-daily frequency.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-pharmacy-order-cs.html#ng-hiv-pharmacy-order-cs-paediatric-abc-60\">paediatric-abc-60</a></td><td style=\"color: #cccccc\">Abacavir 60 mg</td><td>Paediatric ART formulation. The source form permits once- or twice-daily frequency.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-pharmacy-order-cs.html#ng-hiv-pharmacy-order-cs-paediatric-lpv-r-100-25\">paediatric-lpv-r-100-25</a></td><td style=\"color: #cccccc\">Lopinavir/Ritonavir 100/25 mg</td><td>Paediatric ART formulation. The source form preprints twice-daily frequency.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-pharmacy-order-cs.html#ng-hiv-pharmacy-order-cs-paediatric-ral-25\">paediatric-ral-25</a></td><td style=\"color: #cccccc\">Raltegravir 25 mg</td><td>Paediatric ART formulation. The source form preprints twice-daily frequency.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-pharmacy-order-cs.html#ng-hiv-pharmacy-order-cs-paediatric-azt-10-per-ml\">paediatric-azt-10-per-ml</a></td><td style=\"color: #cccccc\">Zidovudine 10 mg/mL</td><td>Paediatric ART formulation. The source form preprints twice-daily frequency.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-pharmacy-order-cs.html#ng-hiv-pharmacy-order-cs-paediatric-dtg-10\">paediatric-dtg-10</a></td><td style=\"color: #cccccc\">Dolutegravir 10 mg</td><td>Paediatric ART formulation. The source form preprints once-daily frequency.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-pharmacy-order-cs.html#ng-hiv-pharmacy-order-cs-paediatric-dtg-5\">paediatric-dtg-5</a></td><td style=\"color: #cccccc\">Dolutegravir 5 mg</td><td>Paediatric ART formulation. The source form preprints once-daily frequency.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-pharmacy-order-cs.html#ng-hiv-pharmacy-order-cs-paediatric-drv-150\">paediatric-drv-150</a></td><td style=\"color: #cccccc\">Darunavir 150 mg</td><td>Paediatric ART formulation. The source form preprints once-daily frequency.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-pharmacy-order-cs.html#ng-hiv-pharmacy-order-cs-paediatric-drv-75\">paediatric-drv-75</a></td><td style=\"color: #cccccc\">Darunavir 75 mg</td><td>Paediatric ART formulation. The source form preprints once-daily frequency.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-pharmacy-order-cs.html#ng-hiv-pharmacy-order-cs-paediatric-rtv-25\">paediatric-rtv-25</a></td><td style=\"color: #cccccc\">Ritonavir 25 mg</td><td>Paediatric ART formulation. The source form preprints once-daily frequency.</td></tr><tr><td><a href=\"CodeSystem-ng-hiv-pharmacy-order-cs.html#ng-hiv-pharmacy-order-cs-paediatric-tdf-3tc-dtg-300-300-50\">paediatric-tdf-3tc-dtg-300-300-50</a></td><td style=\"color: #cccccc\">Tenofovir/Lamivudine/Dolutegravir 300/300/50 mg</td><td>ART formulation listed in the paediatric section of the source form; dosing should follow the applicable dosing wheel or chart.</td></tr></table></li></ul></div>"
