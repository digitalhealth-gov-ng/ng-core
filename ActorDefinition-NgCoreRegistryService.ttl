  ], [
     fhir:index 12 ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-ActorDefinition.purpose" ] ;
     fhir:Extension.valueMarkdown [ fhir:value "Defines the role responsible for trusted registration, identification, lookup,\nmatching, verification, and retrieval of entities shared across health\nprograms, facilities, and interoperable systems." ]
  ], [
     fhir:index 13 ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-ActorDefinition.type" ] ;
