# - resource -------------------------------------------------------------------

<https://fhir-ig.digitalhealth.gov.ng/Measure/NgMeasure-HIV-ART-Monthly> a fhir:Measure ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "NgMeasure-HIV-ART-Monthly"] ;
  fhir:Resource.meta [
     fhir:Meta.profile [
       fhir:value "https://fhir-ig.digitalhealth.gov.ng/StructureDefinition/ng-measure" ;
